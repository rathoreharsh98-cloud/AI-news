# ==============================================================================
# VERITAS OSINT — Environment Variable Configuration Template (.env.example)
# Phase 5: DevOps Engineer Deliverable
# Copy to .env for local or containerized overrides: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Service Ports
# ------------------------------------------------------------------------------
NODE_ENV=production
FRONTEND_PORT=3000
PORT=8081
TELEMETRY_INGEST_PORT=8082
AGPL_SIDECAR_PORT=8091

# ------------------------------------------------------------------------------
# 2. Internal Microservice Endpoints (Docker Compose Service Discovery)
# ------------------------------------------------------------------------------
API_GATEWAY_URL=http://veritas-api-gateway:8081
TELEMETRY_INGEST_URL=http://telemetry-ingestion:8082
AGPL_SIDECAR_URL=http://worldmonitor-cleanroom-adapter:8091
REDIS_URL=redis://redis-telemetry-cache:6379
QDRANT_URL=http://qdrant-vector:6333

# ------------------------------------------------------------------------------
# 3. Rate Limiting & Cache TTL Parameters (Safe Harbour & Quota Protection)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
FEED_CACHE_TTL_MS=60000
DOSSIER_CACHE_TTL_MS=300000
TELEMETRY_CACHE_TTL_MS=30000
STREAM_POLL_INTERVAL_MS=5000

# ------------------------------------------------------------------------------
# 4. Upstream Public Telemetry & Wire Endpoints (Zero-Key Default)
# ------------------------------------------------------------------------------
USGS_GEOJSON_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_day.geojson
NASA_EONET_URL=https://eonet.gsfc.nasa.gov/api/v3/events
OPENSKY_STATES_URL=https://opensky-network.org/api/states/all
GDELT_DOC_API_URL=https://api.gdeltproject.org/api/v2/doc/doc

# ------------------------------------------------------------------------------
# 5. Optional AI Consensus Synthesis (Never commit actual secrets)
# ------------------------------------------------------------------------------
# Optional server-side or BYO Gemini API key for live LLM consensus synthesis.
# Leave blank to use deterministic Safe Harbour Bayesian consensus fallback.
GEMINI_API_KEY=
