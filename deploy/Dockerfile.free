# VERITAS OSINT - slim image for the free 1 GB GCP e2-micro (and the mini PC)
# Build:  docker compose -f deploy/docker-compose.free.yml build
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
# Lower memory use so the build survives 1 GB RAM + swap
ENV NODE_OPTIONS=--max-old-space-size=512
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm test && npm run build

FROM nginx:1.27-alpine AS web
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/dist /usr/share/nginx/html
RUN chown -R 101:101 /usr/share/nginx/html /var/cache/nginx
USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]

FROM node:20-alpine AS api
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY src/ ./src/
USER node
ENV NODE_ENV=production PORT=8081
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -q --spider http://127.0.0.1:8081/healthz || exit 1
CMD ["node", "--max-old-space-size=128", "src/server/apiServer.js"]
